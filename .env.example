APP_NAME="Landing Page SMK Budi Mulia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Di produksi WAJIB alamat final dengan https (mis. https://smkbudimulia.sch.id): dipakai untuk canonical,
# og:url, sitemap.xml, dan robots.txt. Bukan diambil dari header Host.
APP_URL=http://localhost:8000
# Mesin pencari hanya boleh mengindeks environment produksi. Kosongkan (otomatis) atau paksa true/false.
# SEO_INDEXABLE=
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Foto & video situs disimpan sebagai file di public/media (database hanya menyimpan path-nya).
# Ubah MEDIA_ROOT hanya bila folder itu harus di tempat lain; MEDIA_URL adalah alamat publiknya.
# MEDIA_ROOT=
# MEDIA_URL=/media
# Batas unggah video (MB). Samakan upload_max_filesize & post_max_size di php.ini server (>= nilai ini).
MEDIA_MAX_VIDEO_MB=50

# Skema database sama dengan produksi (u282680727_db_sekolah.sql) kecuali 7 kolom foto/video yang kini VARCHAR(500) berisi path.
# Tabel framework (sessions/cache/jobs) sengaja tidak dibuat: session & cache
# memakai file, queue sync.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=budi_mulia
DB_USERNAME=root
DB_PASSWORD=
# Zona waktu koneksi = APP_TIMEZONE (Asia/Jakarta), supaya kolom timestamp konsisten.
DB_TIMEZONE=+07:00

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Isi true di produksi (HTTPS) supaya cookie session tidak pernah lewat HTTP.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@smkbudimuliakrw.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Tujuan pesan dari formulir kontak di landing page.
CONTACT_MAIL_TO=websmkbmkrw@gmail.com

# Link pendaftaran PPDB eksternal (tombol "Daftar" di landing page).
PPDB_URL="https://sumberbarokah.ponpes.id/registrasi/index.php?page=SMK"

# Wajib true di semua environment - mencegah tombol back browser menampilkan
# halaman lama (form login basi / dashboard akun lain) dari cache riwayat Inertia.
INERTIA_ENCRYPT_HISTORY=true

VITE_APP_NAME="${APP_NAME}"

# Web push pengingat absen (modul absensi). Salin PERSIS dari .env absensi lama supaya langganan HP guru tetap jalan.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@example.com"
RESEND_API_KEY=

# Koneksi BACA-SAJA ke basis data absensi lama. Sejak digabung hanya dipakai sekali oleh
# `php artisan gabung:impor-absensi` (dan classroom:sinkron-guru lama); hapus sesudah impor produksi selesai.
ABSENSI_DB_HOST=127.0.0.1
ABSENSI_DB_PORT=3306
ABSENSI_DB_DATABASE=absensi
ABSENSI_DB_USERNAME=root
ABSENSI_DB_PASSWORD=
